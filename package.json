{
  "name": "funkloch",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Signal history for every Zigbee and Thread device: trends, events and alerts for Zigbee2MQTT and OpenThread Border Router",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "bun serve.ts",
    "demo": "FUNKLOCH_DEMO=1 bun --bun vite dev",
    "record": "bun scripts/record.ts",
    "typecheck": "bun run paraglide && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun --bun vitest run --project unit",
    "test:watch": "bun --bun vitest --project unit",
    "e2e": "playwright test --project=chromium --project=auth",
    "screenshots": "playwright test --project=screenshots",
    "db:generate": "drizzle-kit generate",
    "check": "bun run typecheck && bun run lint && bun run test",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "postversion": "git push --follow-tags",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations",
    "postinstall": "bun run paraglide",
    "test:integration": "bun --bun vitest run --project integration"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "mqtt": "^5.16.0",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.5.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
